general {
    output_format = "i3bar"
    colors = true
    interval = 5
    color_good = "#50fa7b"
    color_bad = "#ff5555"
    color_degraded = "#f1fa8c"
    markup = "pango"
}

order += "wireless wlp2s0"
order += "wireless wlp4s0"
order += "ethernet enp3s0"
order += "disk /"
order += "disk /home"
order += "memory"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "battery 0"
order += "volume master"
order += "tztime local"

wireless wlp2s0 {
    format_up = "<span color='#50fa7b'>📶</span> %quality% at %essid"
    format_down = "<span color='#ff5555'>📶</span> WiFi Down"
    format_quality = "%03d%s"
}

wireless wlp4s0 {
    format_up = "<span color='#50fa7b'>📶</span> %quality% at %essid"
    format_down = "<span color='#ff5555'>📶</span> WiFi Down"
    format_quality = "%03d%s"
}

ethernet enp3s0 {
    format_up = "<span color='#50fa7b'>🌐</span> %ip (%speed)"
    format_down = "<span color='#6272a4'>🌐</span> Disconnected"
}

disk "/" {
    format = "<span color='#8be9fd'>💾</span> Root: %avail"
    threshold_type = "percentage_avail"
    low_threshold = 10
    format_below_threshold = "<span color='#ff5555'>💾</span> Root: %avail"
}

disk "/home" {
    format = "<span color='#8be9fd'>🏠</span> Home: %avail"
    threshold_type = "percentage_avail"
    low_threshold = 10
    format_below_threshold = "<span color='#ff5555'>🏠</span> Home: %avail"
}

memory {
    format = "<span color='#bd93f9'>🧠</span> %used/%total"
    threshold_degraded = "10%"
    threshold_critical = "5%"
    format_degraded = "<span color='#f1fa8c'>🧠</span> %used/%total"
}

cpu_usage {
    format = "<span color='#ffb86c'>⚡</span> %usage"
    max_threshold = 75
    format_above_threshold = "<span color='#ff5555'>⚡</span> %usage"
    degraded_threshold = 50
    format_above_degraded_threshold = "<span color='#f1fa8c'>⚡</span> %usage"
}

cpu_temperature 0 {
    format = "<span color='#ffb86c'>🌡️</span> %degrees°C"
    max_threshold = 70
    format_above_threshold = "<span color='#ff5555'>🌡️</span> %degrees°C"
    path = "/sys/class/hwmon/hwmon*/temp1_input"
}

battery 0 {
    format = "%status %percentage %remaining"
    format_down = "<span color='#6272a4'>🔋</span> No Battery"
    status_chr = "<span color='#50fa7b'>🔌</span>"
    status_bat = "<span color='#f1fa8c'>🔋</span>"
    status_unk = "<span color='#6272a4'>❓</span>"
    status_full = "<span color='#50fa7b'>🔋</span>"
    low_threshold = 20
    threshold_type = "percentage"
    format_below_threshold = "<span color='#ff5555'>🔋</span> %percentage %remaining"
    integer_battery_capacity = true
    hide_seconds = true
}

volume master {
    format = "<span color='#50fa7b'>🔊</span> %volume"
    format_muted = "<span color='#ff5555'>🔇</span> Muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = "<span color='#f8f8f2'>📅</span> %Y-%m-%d <span color='#f8f8f2'>🕐</span> %H:%M:%S"
}
