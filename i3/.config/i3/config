# i3 config file (v4)

# Set mod key
set $mod Mod4

# Font for window titles and bar (required in i3v4)
font pango:JetBrains Mono Nerd Font 10

# Colors - generated by the theme switcher (Mod+t)
include ~/.config/i3/theme.conf


# Gaps configuration
gaps inner 10
gaps outer 4

smart_gaps off

# brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Increase brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +10%

# Volume up
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%

# Volume down
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%

# Mute/unmute
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Media player controls (playerctl)
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# Screen lock
bindsym $mod+Escape exec --no-startup-id ~/.local/bin/dots-lock

# Clipboard manager (rofi-greenclip)
bindsym $mod+v exec rofi -modi "clipboard:greenclip print" -show clipboard

# Main menu hub (Omarchy-style): apps, theme, wallpaper, sessions, wifi, power...
bindsym $mod+Mod1+space exec --no-startup-id ~/.local/bin/dots-menu

# Theme: picker (Mod+t or Mod+Ctrl+Shift+Space), cycle next (Mod+Ctrl+t)
bindsym $mod+t exec --no-startup-id ~/.local/bin/dots-theme-menu
bindsym $mod+Ctrl+Shift+space exec --no-startup-id ~/.local/bin/dots-theme-menu
bindsym $mod+Ctrl+t exec --no-startup-id ~/.local/bin/dots-theme-next

# Wallpaper: picker (Mod+Shift+b), cycle next within theme (Mod+Ctrl+Space)
bindsym $mod+Shift+b exec --no-startup-id ~/.local/bin/dots-bg-menu
bindsym $mod+Ctrl+space exec --no-startup-id ~/.local/bin/dots-bg-next

# Keybinding reference
bindsym $mod+Shift+slash exec --no-startup-id ~/.local/bin/dots-keys

# Media launchers
bindsym $mod+m exec kitty -e ncspot
bindsym $mod+Shift+a exec kitty -e ani-cli
bindsym $mod+Shift+v exec kitty -e lobster

# Key bindings
bindsym $mod+Return exec kitty
bindsym $mod+d exec --no-startup-id ~/.local/bin/dots-menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+z exec zen
bindsym $mod+b exec firefox
bindsym $mod+f fullscreen toggle

# Launch tmux sessions (dots-session --menu lists them all)
bindsym $mod+Shift+w exec kitty -e ~/.local/bin/dots-session work
bindsym $mod+Shift+t exec kitty -e ~/.local/bin/dots-session scalestash

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window (Vim-style)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


bindsym $mod+a split v
bindsym $mod+minus split h
bindsym $mod+equal layout toggle split


# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+c move position center


# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Launch flameshot GUI to select area
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Shift+f exec --no-startup-id flameshot full -p ~/Pictures
bindsym $mod+Shift+c exec --no-startup-id flameshot gui -c



# Workspaces with icons
set $ws1 "1:  browser"
set $ws2 "2:  work"
set $ws3 "3:  dev"
set $ws4 "4:  slack"
set $ws5 "5:  scale"
set $ws6 "6:  misc"
set $ws7 "7: 󰎈 media"
set $ws8 "8:  docs"
set $ws9 "9:  term"
set $ws10 "10:  config"


# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Executables to autostart

# Compositor and notifications
exec --no-startup-id picom -b
exec --no-startup-id dunst

# Screen lock on suspend
exec --no-startup-id xss-lock -- ~/.local/bin/dots-lock

# Clipboard daemon
exec --no-startup-id greenclip daemon


# Fast keyboard repeat (200ms delay, 50/sec rate)
exec --no-startup-id xset r rate 200 50

exec --no-startup-id xinput list --name-only | grep -i touchpad | xargs -I {} xinput set-prop "{}" "libinput Natural Scrolling Enabled" 1

# Monitors, then restore the remembered wallpaper
exec_always --no-startup-id ~/.config/i3/display-setup.sh
exec_always --no-startup-id ~/.local/bin/dots-bg-set



# Startup apps (minimal)
exec --no-startup-id ~/.config/i3/startup-apps.sh

# Polybar (replaces i3bar)
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id ~/.config/polybar/watch-monitors.sh

# Window border - green on the focused window (theme.conf); picom rounds the corners
for_window [class=".*"] border pixel 3
