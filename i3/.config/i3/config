# i3 config file (v4)

# Set mod key
set $mod Mod4

# Font for window titles and bar (required in i3v4)
font pango:JetBrains Mono Nerd Font 10


# Gaps configuration
gaps inner 10
gaps outer 4 

smart_gaps off

# brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Increase brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +10%

# Volume up
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%

# Volume down
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%

# Mute/unmute
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Media player controls (playerctl)
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# Screen lock
bindsym $mod+Escape exec i3lock -c 1a1b26

# Clipboard manager (rofi-greenclip)
bindsym $mod+v exec rofi -modi "clipboard:greenclip print" -show clipboard

# Key bindings
bindsym $mod+Return exec kitty
bindsym $mod+d exec rofi -show drun
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+z exec zen
bindsym $mod+b exec firefox
bindsym $mod+p exec dmenu_run -fn 'JetBrainsMono Nerd Font-12' -nb '#1a1b26' -nf '#c0caf5' -sb '#7aa2f7' -sf '#1a1b26'
bindsym $mod+f fullscreen toggle

# Launch tmux sessions
bindsym $mod+Shift+w exec kitty -e ~/.config/i3/work-tmux-session.sh
bindsym $mod+Shift+t exec kitty -e ~/.config/i3/scalestash-tmux-session.sh

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window (Vim-style)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


bindsym $mod+a split v
bindsym $mod+minus split h
bindsym $mod+equal layout toggle split


# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+c move position center


# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Launch flameshot GUI to select area
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Shift+f exec --no-startup-id flameshot full -p ~/Pictures
bindsym $mod+Shift+c exec --no-startup-id flameshot gui -c



# Workspaces with icons
set $ws1 "1:  browser"
set $ws2 "2:  work"
set $ws3 "3:  dev"
set $ws4 "4:  slack"
set $ws5 "5:  scale"
set $ws6 "6:  misc"
set $ws7 "7: 󰎈 media"
set $ws8 "8:  docs"
set $ws9 "9:  term"
set $ws10 "10:  config"


# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Executables to autostart

# Compositor and notifications
exec --no-startup-id picom -b
exec --no-startup-id dunst

# Screen lock on suspend
exec --no-startup-id xss-lock -- i3lock -c 1a1b26

# Clipboard daemon
exec --no-startup-id greenclip daemon

# System tray
exec --no-startup-id nm-applet
exec --no-startup-id volumeicon
exec --no-startup-id blueman-applet

exec --no-startup-id xinput list --name-only | grep -i touchpad | xargs -I {} xinput set-prop "{}" "libinput Natural Scrolling Enabled" 1

exec_always --no-startup-id sh -c 'feh --bg-fill "$HOME/Pictures/wallpapers/an.jpg"'



# Open first 4 workspaces
exec --no-startup-id i3-msg "workspace $ws1"
exec --no-startup-id i3-msg "workspace $ws2"
exec --no-startup-id i3-msg "workspace $ws3"
exec --no-startup-id i3-msg "workspace $ws4"

# privacy red light
exec --no-startup-id redshift -l auto

# Launch Firefox browser on workspace 1
exec --no-startup-id i3-msg "workspace 1; exec firefox"

# Launch tmux session on work workspace
exec --no-startup-id i3-msg "workspace $ws2; exec kitty -e ~/.config/i3/work-tmux-session.sh"

# Launch tmux session on scalestash workspace
exec --no-startup-id i3-msg "workspace $ws5; exec kitty -e ~/.config/i3/scalestash-tmux-session.sh"

# Launch Slack on workspace 4
exec --no-startup-id i3-msg "workspace $ws4; exec google-chrome --app=https://app.slack.com --class=SlackWebApp --user-data-dir=~/.local/share/webapps/slack-chrome-profile --no-first-run --disable-infobars --disable-session-crashed-bubble"

# Tokyo Night colors
set $bg         #1a1b26
set $fg         #c0caf5
set $black      #15161e
set $red        #f7768e
set $green      #9ece6a
set $yellow     #e0af68
set $blue       #7aa2f7
set $magenta    #bb9af7
set $cyan       #7dcfff
set $white      #a9b1d6

bar {
    status_command i3blocks -c ~/.config/i3/i3blocks.conf
    position top
    font pango:JetBrainsMono Nerd Font 11
    height 28
    workspace_min_width 40
    colors {
        background $bg
        statusline $fg
        separator  $black
        #                  border   bg       text
        focused_workspace  $blue    $blue    $bg
        active_workspace   $bg      $bg      $fg
        inactive_workspace $bg      $bg      $white
        urgent_workspace   $red     $red     $bg
    }
}

for_window [class=".*"] border pixel 1

#                       border   bg       text     indicator child_border
client.focused          $blue    $blue    $bg      $cyan     $blue
client.unfocused        $bg      $bg      $white   $bg       $bg
client.focused_inactive $black   $black   $white   $black    $black
client.urgent           $red     $red     $bg      $red      $red

