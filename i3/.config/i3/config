# i3 config file (v4)

# Set mod key
set $mod Mod4

# Font for window titles and bar (required in i3v4)
font pango:JetBrains Mono Nerd Font 10


# Gaps configuration
gaps inner 10
gaps outer 4 

smart_gaps off


# Key bindings
bindsym $mod+Return exec kitty
bindsym $mod+d exec rofi -show drun
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+z exec zen
bindsym $mod+b exec firefox
bindsym $mod+p exec dmenu_run
bindsym $mod+f fullscreen toggle

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window (Vim-style)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Arrow keys as alternative
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


# SPLIT
bindsym $mod+a split v
bindsym $mod+minus split h
bindsym $mod+equal layout toggle split


# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+c move position center


# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Launch flameshot GUI to select area
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
# Take fullscreen screenshot, save to ~/Pictures with timestamp
bindsym $mod+Shift+f exec --no-startup-id flameshot full -p ~/Pictures
bindsym $mod+Shift+c exec --no-startup-id flameshot gui -c



set $ws1 "1:   "
set $ws2 "2:   "
set $ws3 "3:   "
set $ws4 "4:   "
set $ws5 "5:   "
set $ws6 "6:   "
set $ws7 "7:   "
set $ws8 "8:   "
set $ws9 "9:   "
set $ws10 "10:   "


# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Executables to autostart

# Needed defaults
exec --no-startup-id nm-applet
exec --no-startup-id volumeicon      
exec --no-startup-id blueman-applet

exec --no-startup-id xinput list --name-only | grep -i touchpad | xargs -I {} xinput set-prop "{}" "libinput Natural Scrolling Enabled" 1

#  wallpaper
exec_always --no-startup-id sh -c 'feh --bg-fill "$HOME/Pictures/wallpapers/an.jpg"'



# Open first 4 workspaces
exec --no-startup-id i3-msg "workspace $ws1"
exec --no-startup-id i3-msg "workspace $ws2"
exec --no-startup-id i3-msg "workspace $ws3"
exec --no-startup-id i3-msg "workspace $ws4"

# Launch Slack on workspace 4
# add slack to workspace 4
exec --no-startup-id i3-msg "workspace $ws4; exec slack"

bar {
    status_command i3blocks -c ~/.config/i3/i3blocks.conf
    position top
    font pango:JetBrainsMono Nerd Font 12
}


for_window [class=".*"] border pixel 2
for_window [floating] resize set 1200 800, move position center


client.focused          #00FF00 #00FF00 #00FF00 #00FF00 #00FF00
client.unfocused        #222222 #222222 #222222 #222222 #222222
client.focused_inactive #444444 #444444 #444444 #444444 #444444
client.urgent           #FF0000 #FF0000 #FF0000 #FF0000 #FF0000

