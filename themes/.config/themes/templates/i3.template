# i3 theme - {{THEME_NAME}}
# Generated by apply-theme.sh; included from ~/.config/i3/config

set $bg         {{BG}}
set $bg_alt     {{BG_ALT}}
set $fg         {{FG}}
set $fg_dim     {{FG_DIM}}
set $black      {{BLACK}}
set $red        {{RED}}
set $green      {{GREEN}}
set $yellow     {{YELLOW}}
set $blue       {{BLUE}}
set $magenta    {{MAGENTA}}
set $cyan       {{CYAN}}
set $white      {{WHITE}}
set $primary    {{PRIMARY}}
set $secondary  {{SECONDARY}}

#                       border      bg          text     indicator   child_border
client.focused          $primary    $primary    $bg      $secondary  $primary
client.focused_inactive $bg_alt     $bg_alt     $white   $bg_alt     $bg_alt
client.unfocused        $bg         $bg         $fg_dim  $bg         $bg
client.urgent           $red        $red        $bg      $red        $red
client.placeholder      $bg         $bg         $fg_dim  $bg         $bg
client.background       $bg
