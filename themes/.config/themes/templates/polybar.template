;==========================================================
;   Polybar - {{THEME_NAME}}
;   Omarchy-style: one flat monochrome bar, icons only.
;==========================================================

[colors]
background = {{BG}}
foreground = {{FG}}
dim = {{FG_DIM}}
primary = {{PRIMARY}}
alert = {{RED}}

[bar/main]
monitor = ${env:MONITOR:}
width = 100%
height = 28
dpi = 96
radius = 0
bottom = false
fixed-center = true
override-redirect = false
enable-ipc = true
enable-struts = true

background = ${colors.background}
foreground = ${colors.foreground}
line-size = 0
border-size = 0
padding-left = 1
padding-right = 1
module-margin = 0
separator =

font-0 = "JetBrainsMono Nerd Font:size=11;3"
font-1 = "JetBrainsMono Nerd Font:size=13;3"

modules-left = menu workspaces
modules-center = clock
modules-right = tray bluetooth wifi wired pulseaudio cpu battery

cursor-click = pointer
cursor-scroll = ns-resize

;==========================================================
;   Left
;==========================================================

[module/menu]
type = custom/text
format = "%{T2}󰍜%{T-}"
format-padding = 2
click-left = ~/.local/bin/dots-menu
click-right = kitty

[module/workspaces]
type = internal/i3
pin-workspaces = true
show-urgent = true
index-sort = true
enable-scroll = false

label-focused = 󱓻
label-focused-foreground = ${colors.foreground}
label-focused-padding = 1

label-unfocused = %index%
label-unfocused-foreground = ${colors.dim}
label-unfocused-padding = 1

label-visible = %index%
label-visible-foreground = ${colors.foreground}
label-visible-padding = 1

label-urgent = %index%
label-urgent-foreground = ${colors.alert}
label-urgent-padding = 1

label-mode = %mode%
label-mode-foreground = ${colors.alert}
label-mode-padding = 1

;==========================================================
;   Center
;==========================================================

[module/clock]
type = internal/date
interval = 30
date = %A
time = %H:%M
label = %date% %time%
click-left = ~/.local/bin/dots-menu

;==========================================================
;   Right (icons only; click opens the matching rofi menu)
;==========================================================

[module/tray]
type = internal/tray
tray-spacing = 10px
tray-size = 14
tray-padding = 4

[module/bluetooth]
type = custom/script
exec = ~/.config/polybar/scripts/bluetooth.sh
interval = 5
format = <label>
format-padding = 1
click-left = ~/.local/bin/dots-bluetooth

[module/wifi]
type = internal/network
interface-type = wireless
interval = 3
format-connected = %{A1:~/.local/bin/dots-wifi:}<ramp-signal>%{A}
format-connected-padding = 1
format-disconnected = %{A1:~/.local/bin/dots-wifi:}󰤮%{A}
format-disconnected-foreground = ${colors.dim}
format-disconnected-padding = 1
ramp-signal-0 = 󰤯
ramp-signal-1 = 󰤟
ramp-signal-2 = 󰤢
ramp-signal-3 = 󰤥
ramp-signal-4 = 󰤨

[module/wired]
type = internal/network
interface-type = wired
interval = 3
format-connected = %{A1:~/.local/bin/dots-wifi:}󰀂%{A}
format-connected-padding = 1
format-disconnected =

[module/pulseaudio]
type = internal/pulseaudio
use-ui-max = false
format-volume = %{A1:pavucontrol:}<ramp-volume>%{A}
format-volume-padding = 1
format-muted = %{A1:pavucontrol:}<label-muted>%{A}
format-muted-padding = 1
label-muted = 󰝟
label-muted-foreground = ${colors.dim}
ramp-volume-0 = 󰕿
ramp-volume-1 = 󰖀
ramp-volume-2 = 󰕾
ramp-headphones-0 = 󰋋
click-right = pactl set-sink-mute @DEFAULT_SINK@ toggle
scroll-up = pactl set-sink-volume @DEFAULT_SINK@ +5%
scroll-down = pactl set-sink-volume @DEFAULT_SINK@ -5%

[module/cpu]
type = internal/cpu
interval = 5
format = %{A1:kitty -e btop:}󰍛%{A}
format-padding = 1

[module/battery]
type = internal/battery
battery = BAT1
adapter = ACAD
full-at = 98
low-at = 15
poll-interval = 5

format-charging = %{A1:~/.local/bin/dots-power:}<animation-charging>%{A}
format-charging-padding = 1
format-discharging = %{A1:~/.local/bin/dots-power:}<ramp-capacity>%{A}
format-discharging-padding = 1
format-full = %{A1:~/.local/bin/dots-power:}󰂅%{A}
format-full-padding = 1
format-low = %{A1:~/.local/bin/dots-power:}<ramp-capacity> <label-low>%{A}
format-low-foreground = ${colors.alert}
format-low-padding = 1
label-low = %percentage%%

ramp-capacity-0 = 󰁺
ramp-capacity-1 = 󰁻
ramp-capacity-2 = 󰁼
ramp-capacity-3 = 󰁽
ramp-capacity-4 = 󰁾
ramp-capacity-5 = 󰁿
ramp-capacity-6 = 󰂀
ramp-capacity-7 = 󰂁
ramp-capacity-8 = 󰂂
ramp-capacity-9 = 󰁹

animation-charging-0 = 󰢜
animation-charging-1 = 󰂆
animation-charging-2 = 󰂇
animation-charging-3 = 󰂈
animation-charging-4 = 󰢝
animation-charging-5 = 󰂉
animation-charging-6 = 󰢞
animation-charging-7 = 󰂊
animation-charging-8 = 󰂋
animation-charging-9 = 󰂅
animation-charging-framerate = 750

[settings]
screenchange-reload = true
pseudo-transparency = false
