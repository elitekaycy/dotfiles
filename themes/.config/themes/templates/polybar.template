;==========================================================
;   Polybar Config - {{THEME_NAME}}
;==========================================================

[colors]
background = {{BG}}
background-alt = {{BG_ALT}}
foreground = {{FG}}
primary = {{PRIMARY}}
secondary = {{SECONDARY}}
alert = {{RED}}
disabled = {{FG_DIM}}
green = {{GREEN}}
yellow = {{YELLOW}}
cyan = {{CYAN}}
magenta = {{MAGENTA}}

[bar/main]
monitor = ${env:MONITOR:}
width = 100%
height = 36
dpi = 96
radius = 0
offset-x = 0
offset-y = 0
bottom = false
fixed-center = true
override-redirect = false

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 2

border-size = 0
border-color = #00000000

padding-left = 2
padding-right = 2

module-margin = 1

separator = ""
separator-foreground = ${colors.disabled}

font-0 = "JetBrainsMono Nerd Font:size=10;3"
font-1 = "JetBrainsMono Nerd Font:size=12;3"

modules-left = i3
modules-center = date
modules-right = network bluetooth pulseaudio battery power

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true
enable-struts = true

;==========================================================
;   Modules
;==========================================================

[module/i3]
type = internal/i3
pin-workspaces = true
show-urgent = true
strip-wsnumbers = true
index-sort = true

label-mode = " 󰉋 %mode% "
label-mode-padding = 1
label-mode-background = ${colors.alert}

label-focused = " 󰉋 %name% "
label-focused-foreground = ${colors.primary}
label-focused-underline = ${colors.primary}
label-focused-padding = 0

label-unfocused = " %index% "
label-unfocused-foreground = ${colors.disabled}
label-unfocused-padding = 0

label-visible = " %index% "
label-visible-foreground = ${colors.secondary}
label-visible-underline = ${colors.secondary}
label-visible-padding = 0

label-urgent = " %index% "
label-urgent-foreground = ${colors.alert}
label-urgent-underline = ${colors.alert}
label-urgent-padding = 0

[module/date]
type = internal/date
interval = 30

date = %A %b %d
time = %I:%M %p

label = " 󰥔 %date% %time% "
label-foreground = ${colors.foreground}
click-left = sh -c 'notify-send "$(date "+%A, %B %d")" "$(date "+%I:%M %p")"'

[module/network]
type = custom/script
exec = ~/.config/polybar/scripts/network.sh
interval = 5
click-left = ~/.local/bin/dots-wifi
format = <label>
format-padding = 1
label-maxlen = 12
label-foreground = ${colors.cyan}

[module/bluetooth]
type = custom/script
exec = ~/.config/polybar/scripts/bluetooth.sh
interval = 5
click-left = ~/.local/bin/dots-bluetooth
format = <label>
format-padding = 1
label-maxlen = 4
label-foreground = ${colors.primary}

[module/pulseaudio]
type = internal/pulseaudio
use-ui-max = false

format-volume = <ramp-volume> <label-volume>
format-volume-foreground = ${colors.magenta}
format-volume-padding = 1

label-volume = %percentage%%

label-muted = 󰝟
label-muted-foreground = ${colors.disabled}
label-muted-padding = 1

ramp-volume-0 = 󰕿
ramp-volume-1 = 󰖀
ramp-volume-2 = 󰕾

click-left = pactl set-sink-mute @DEFAULT_SINK@ toggle
click-right = pavucontrol &
scroll-up = pactl set-sink-volume @DEFAULT_SINK@ +5%
scroll-down = pactl set-sink-volume @DEFAULT_SINK@ -5%

[module/battery]
type = internal/battery
battery = BAT1
adapter = ACAD
full-at = 98
low-at = 15
poll-interval = 5

format-charging = <animation-charging> <label-charging>
format-charging-foreground = ${colors.green}
format-charging-padding = 1

format-discharging = <ramp-capacity> <label-discharging>
format-discharging-foreground = ${colors.yellow}
format-discharging-padding = 1

format-full =  <label-full>
format-full-foreground = ${colors.green}
format-full-padding = 1

format-low = <animation-low> <label-low>
format-low-foreground = ${colors.alert}
format-low-padding = 1

label-charging = %percentage%%
label-discharging = %percentage%%
label-full = Full
label-low = %percentage%% LOW

ramp-capacity-0 =
ramp-capacity-1 =
ramp-capacity-2 =
ramp-capacity-3 =
ramp-capacity-4 =

animation-charging-0 =
animation-charging-1 =
animation-charging-2 =
animation-charging-3 =
animation-charging-4 =
animation-charging-framerate = 750

animation-low-0 =
animation-low-1 =
animation-low-framerate = 500

[module/power]
type = custom/text
format = " ⏻ "
format-foreground = ${colors.alert}
click-left = ~/.local/bin/dots-power

[settings]
screenchange-reload = true
pseudo-transparency = true
