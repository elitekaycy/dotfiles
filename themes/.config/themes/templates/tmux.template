# tmux theme - {{THEME_NAME}}
# Generated by apply-theme.sh; sourced from ~/.tmux.conf

set -g status on
set -g status-position bottom
set -g status-justify left
set -g status-interval 5
set -g status-style "bg={{BG}},fg={{FG}}"

set -g status-left-length 40
set -g status-left "#[fg={{BG}},bg={{PRIMARY}},bold]  #S #[fg={{PRIMARY}},bg={{BG}}] "

set -g window-status-separator ""
set -g window-status-format "#[fg={{FG_DIM}},bg={{BG}}]  #I #W  "
set -g window-status-current-format "#[fg={{BG}},bg={{SECONDARY}},bold]  #I #W  "
set -g window-status-activity-style "fg={{YELLOW}}"
set -g window-status-bell-style "fg={{RED}}"

set -g status-right-length 60
set -g status-right "#[fg={{FG_DIM}}] #{?client_prefix,#[fg={{RED}}] ,}#[fg={{FG_DIM}}]%a %d %b #[fg={{FG}},bold]%H:%M "

set -g pane-border-style "fg={{BG_ALT}}"
set -g pane-active-border-style "fg={{PRIMARY}}"
set -g pane-border-lines single

set -g message-style "bg={{BG_ALT}},fg={{FG}}"
set -g message-command-style "bg={{BG_ALT}},fg={{PRIMARY}}"
set -g mode-style "bg={{PRIMARY}},fg={{BG}}"
set -g clock-mode-colour "{{PRIMARY}}"
set -g display-panes-colour "{{FG_DIM}}"
set -g display-panes-active-colour "{{PRIMARY}}"
