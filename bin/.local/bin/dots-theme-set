#!/usr/bin/env bash
# Render every themed config from one theme source and reload the desktop.
#
#   dots-theme-set [--no-reload] <theme-id>
#
# Theme sources:   ~/.config/themes/themes/<id>.conf
# Templates:       ~/.config/themes/templates/<app>.template
# Wallpapers:      ~/Pictures/wallpapers/<id>/
# Selected theme:  ~/.local/state/dotfiles/theme
set -Eeuo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
THEMES_DIR="$CONFIG_HOME/themes"
THEMES_CONF_DIR="$THEMES_DIR/themes"
TEMPLATES_DIR="$THEMES_DIR/templates"
WALLPAPER_ROOT="$HOME/Pictures/wallpapers"
CURRENT_THEME_FILE="$STATE_DIR/theme"
RELOAD_APPS=true

log_info() { printf '\033[0;34m[INFO]\033[0m %s\n' "$1"; }
log_ok() { printf '\033[0;32m[OK]\033[0m %s\n' "$1"; }
log_warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$1"; }
log_error() { printf '\033[0;31m[ERROR]\033[0m %s\n' "$1" >&2; }

if [[ "${1:-}" == "--no-reload" ]]; then
    RELOAD_APPS=false
    shift
fi

THEME_ID="${1:-}"
if [[ -z "$THEME_ID" ]]; then
    echo "Usage: dots-theme-set [--no-reload] <theme-id>"
    echo "Available themes:"
    for theme in "$THEMES_CONF_DIR"/*.conf; do
        [[ -f "$theme" ]] && basename "$theme" .conf
    done
    exit 1
fi

THEME_FILE="$THEMES_CONF_DIR/$THEME_ID.conf"
if [[ ! -f "$THEME_FILE" ]]; then
    log_error "Theme not found: $THEME_ID"
    exit 1
fi

source "$THEME_FILE"
: "${THEME_NAME:?Theme must define THEME_NAME}"
: "${THEME_TYPE:?Theme must define THEME_TYPE}"
: "${NVIM_THEME:?Theme must define NVIM_THEME}"

prepare_output() {
    local output="$1"
    local link_target themes_real repository_root

    # Older revisions symlinked generated files into the repository; replace
    # those links with real files. Foreign links are left alone and overwritten.
    if [[ -L "$output" ]]; then
        link_target="$(readlink -f "$output" 2>/dev/null || true)"
        themes_real="$(readlink -f "$THEMES_DIR" 2>/dev/null || true)"
        repository_root="${themes_real%/themes/.config/themes}"
        if [[ -n "$repository_root" && "$link_target" == "$repository_root/"* ]]; then
            rm -- "$output"
        fi
    fi
    mkdir -p "$(dirname "$output")"
}

render() {
    local template="$TEMPLATES_DIR/$1.template"
    local output="$2"
    local content

    if [[ ! -f "$template" ]]; then
        log_error "Template not found: $template"
        return 1
    fi

    content="$(<"$template")"
    content="${content//\{\{THEME_NAME\}\}/$THEME_NAME}"
    content="${content//\{\{THEME_TYPE\}\}/$THEME_TYPE}"
    content="${content//\{\{BG\}\}/$BG}"
    content="${content//\{\{BG_HEX\}\}/${BG#\#}}"
    content="${content//\{\{BG_ALT\}\}/$BG_ALT}"
    content="${content//\{\{FG\}\}/$FG}"
    content="${content//\{\{FG_DIM\}\}/$FG_DIM}"
    content="${content//\{\{PRIMARY\}\}/$PRIMARY}"
    content="${content//\{\{SECONDARY\}\}/$SECONDARY}"
    content="${content//\{\{ACCENT\}\}/$ACCENT}"
    content="${content//\{\{RED\}\}/$RED}"
    content="${content//\{\{GREEN\}\}/$GREEN}"
    content="${content//\{\{YELLOW\}\}/$YELLOW}"
    content="${content//\{\{BLUE\}\}/$BLUE}"
    content="${content//\{\{MAGENTA\}\}/$MAGENTA}"
    content="${content//\{\{CYAN\}\}/$CYAN}"
    content="${content//\{\{WHITE\}\}/$WHITE}"
    content="${content//\{\{BLACK\}\}/$BLACK}"

    prepare_output "$output"
    printf '%s\n' "$content" > "$output"
    log_ok "Rendered: ${output#"$HOME"/}"
}

log_info "Rendering theme: $THEME_ID"
render polybar "$CONFIG_HOME/polybar/config.ini"
render kitty "$CONFIG_HOME/kitty/theme.conf"
render dunst "$CONFIG_HOME/dunst/dunstrc"
render rofi "$CONFIG_HOME/rofi/config.rasi"
render i3 "$CONFIG_HOME/i3/theme.conf"
render tmux "$CONFIG_HOME/tmux/theme.conf"

mkdir -p "$HOME/.local/share/nvim" "$STATE_DIR"
printf '%s\n' "$NVIM_THEME" > "$HOME/.local/share/nvim/pvim_theme.txt"
printf '%s\n' "$THEME_ID" > "$CURRENT_THEME_FILE"

# Wallpaper: keep the current one if it already belongs to this theme,
# otherwise switch to the first wallpaper in the theme's directory.
theme_bg_dir="$WALLPAPER_ROOT/$THEME_ID"
current_bg="$(cat "$CONFIG_HOME/current-wallpaper" 2>/dev/null || true)"
wallpaper=""
if [[ -n "$current_bg" && "$current_bg" == "$theme_bg_dir/"* && -f "$current_bg" ]]; then
    wallpaper="$current_bg"
elif [[ -d "$theme_bg_dir" ]]; then
    wallpaper="$(find "$theme_bg_dir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        2>/dev/null | sort | head -n 1)"
fi

if [[ -n "$wallpaper" ]]; then
    mkdir -p "$CONFIG_HOME"
    printf '%s\n' "$wallpaper" > "$CONFIG_HOME/current-wallpaper"
    if [[ "$RELOAD_APPS" == "true" && -n "${DISPLAY:-}" ]]; then
        "$BIN_DIR/dots-bg-set" "$wallpaper" >/dev/null 2>&1 || true
    fi
else
    log_warn "No wallpapers found in ${theme_bg_dir#"$HOME"/}"
fi

if [[ "$RELOAD_APPS" == "true" && -n "${DISPLAY:-}" ]]; then
    if [[ -x "$CONFIG_HOME/polybar/launch.sh" ]]; then
        "$CONFIG_HOME/polybar/launch.sh" >/dev/null 2>&1 &
    fi

    if command -v kitty >/dev/null; then
        for sock in /tmp/mykitty*; do
            [[ -S "$sock" ]] || continue
            kitty @ --to "unix:$sock" set-colors -a -c "$CONFIG_HOME/kitty/theme.conf" >/dev/null 2>&1 || true
        done
    fi

    if command -v dunst >/dev/null; then
        pkill -x dunst 2>/dev/null || true
        (dunst >/dev/null 2>&1 &)
    fi

    command -v i3-msg >/dev/null && i3-msg reload >/dev/null 2>&1 || true
    if command -v tmux >/dev/null && tmux list-sessions >/dev/null 2>&1; then
        tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
    fi
    command -v notify-send >/dev/null && notify-send "Theme" "$THEME_NAME" -i preferences-desktop-theme || true
fi

log_ok "Theme '$THEME_NAME' applied"
