#!/usr/bin/env bash
# Set the wallpaper on every monitor and remember it.
#
#   dots-bg-set [path]      no path: restore the remembered wallpaper
set -Eeuo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_FILE="$CONFIG_HOME/current-wallpaper"
wallpaper="${1:-}"

if [[ -z "$wallpaper" ]]; then
    wallpaper="$(cat "$STATE_FILE" 2>/dev/null || true)"
    if [[ -z "$wallpaper" ]]; then
        theme="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/theme" 2>/dev/null || echo tokyo-night)"
        wallpaper="$(find "$HOME/Pictures/wallpapers/$theme" -maxdepth 1 -type f 2>/dev/null | sort | head -n 1)"
    fi
fi

[[ -f "$wallpaper" ]] || exit 0
mkdir -p "$CONFIG_HOME"
printf '%s\n' "$wallpaper" > "$STATE_FILE"

command -v feh >/dev/null || exit 0

monitor_count=1
if command -v polybar >/dev/null; then
    monitor_count="$(polybar --list-monitors 2>/dev/null | awk 'END { print NR ? NR : 1 }')"
elif command -v xrandr >/dev/null; then
    monitor_count="$(xrandr --query | awk '/ connected/ && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ { count++ } END { print count ? count : 1 }')"
fi

wallpapers=()
for ((i = 0; i < monitor_count; i++)); do
    wallpapers+=("$wallpaper")
done

feh --bg-fill "${wallpapers[@]}"
