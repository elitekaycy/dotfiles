#!/usr/bin/env bash
# Create or attach a named tmux session.
#
#   dots-session <name>     main | work | scalestash | qkt | any existing session
#   dots-session --menu     pick one in rofi and open it in kitty
set -Eeuo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCALE_ROOT="$HOME/Desktop/scalestash-aws"
QKT_ROOT="$HOME/Desktop/qkt"

window() {
    # window <session> <name> <dir> [command]
    local session="$1" name="$2" dir="$3" cmd="${4:-}"
    if tmux list-windows -t "$session" -F '#W' 2>/dev/null | grep -qx "$name"; then
        return 0
    fi
    if [[ -z "$(tmux list-windows -t "$session" -F '#W' 2>/dev/null)" ]]; then
        tmux new-session -d -s "$session" -n "$name" -c "$dir"
    else
        tmux new-window -t "$session" -n "$name" -c "$dir"
    fi
    [[ -n "$cmd" ]] && tmux send-keys -t "$session:$name" "$cmd" C-m
}

session_main() {
    tmux has-session -t main 2>/dev/null || tmux new-session -d -s main -c "$HOME"
}

session_work() {
    tmux has-session -t work 2>/dev/null && return 0
    local dir="$PWD"
    window work work "$dir" "pvim ."
    window work docs "$dir"
    window work script "$dir"
    window work claude-research "$dir"
    tmux select-window -t work:work
}

session_scalestash() {
    tmux has-session -t scalestash 2>/dev/null && return 0
    [[ -d "$SCALE_ROOT" ]] || { echo "dots-session: $SCALE_ROOT not found" >&2; SCALE_ROOT="$HOME"; }
    window scalestash scalestash "$SCALE_ROOT" "pvim ."
    window scalestash docs "$SCALE_ROOT"
    window scalestash script "$SCALE_ROOT"
    window scalestash claude-research "$SCALE_ROOT"
    tmux select-window -t scalestash:scalestash
}

session_qkt() {
    tmux has-session -t qkt 2>/dev/null && return 0
    [[ -d "$QKT_ROOT" ]] || { echo "dots-session: $QKT_ROOT not found" >&2; QKT_ROOT="$HOME"; }
    window qkt qkt "$QKT_ROOT/qkt" "pvim ."
    window qkt insights "$QKT_ROOT/qkt-insights" "pvim ."
    window qkt research "$QKT_ROOT/qkt-research-lab" "pvim ."
    window qkt mt5 "$QKT_ROOT/mt5-gateway" "pvim ."
    window qkt script "$QKT_ROOT"
    window qkt claude "$QKT_ROOT"
    tmux select-window -t qkt:qkt
}

if [[ "${1:-}" == "--menu" ]]; then
    rows=("󰆍  main" "󰆍  work" "󰆍  scalestash" "󰆍  qkt")
    while IFS= read -r existing; do
        [[ -n "$existing" ]] || continue
        case "$existing" in main|work|scalestash|qkt) continue ;; esac
        rows+=("󰆍  $existing")
    done < <(tmux list-sessions -F '#S' 2>/dev/null || true)
    chosen="$(printf '%s\n' "${rows[@]}" | rofi -dmenu -i -p "Session" -no-custom \
        -theme-str 'window { width: 22em; }' \
        -theme-str "listview { lines: ${#rows[@]}; }")" || exit 0
    [[ -n "$chosen" ]] || exit 0
    exec kitty -e "$BIN_DIR/dots-session" "${chosen##*  }"
fi

name="${1:-main}"
case "$name" in
    main) session_main ;;
    work) session_work ;;
    scalestash) session_scalestash ;;
    qkt) session_qkt ;;
    *) tmux has-session -t "$name" 2>/dev/null || tmux new-session -d -s "$name" ;;
esac

if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$name"
fi
exec tmux attach-session -t "$name"
