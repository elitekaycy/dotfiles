#!/usr/bin/env bash
# The main search (Super+Alt+Space): every system action and every app in one
# rofi list. Type "shutdown", "brightness", "wifi", "firefox"... and hit Enter.
set -Eeuo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec rofi -show combi \
    -modi "combi" \
    -combi-modi "actions:$BIN_DIR/dots-actions,drun" \
    -combi-hide-mode-prefix \
    -display-combi "󰍜 " \
    -theme-str 'window { width: 34em; }' \
    -theme-str 'listview { lines: 12; }'
