#!/usr/bin/env bash
# Secrets from the terminal or rofi.
#
# Backend: pass (GPG files in ~/.password-store, git-synced) when the store is
# initialised (./install.sh pass); otherwise the GNOME keyring, which needs no
# setup. Same commands either way.
#
#   dots-secret set <name>        store (prompts, or reads stdin when piped)
#   dots-secret get <name>        print the secret
#   dots-secret copy <name>       copy to clipboard, cleared after 45s
#   dots-secret ls                list names
#   dots-secret find <text>       list names matching text
#   dots-secret rm <name>         delete
#   dots-secret menu              rofi: pick a name, copy it
#   dots-secret backend           print which backend is active
#   pass only: gen <name> [len] · edit <name> · show <name> · grep <text> · sync
#
# In scripts:  export AWS_SECRET_ACCESS_KEY="$(dots-secret get aws/sandbox)"
set -Eeuo pipefail

STORE="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
if command -v pass >/dev/null && [[ -f "$STORE/.gpg-id" ]]; then
    BACKEND=pass
elif command -v secret-tool >/dev/null; then
    BACKEND=keyring
else
    echo "dots-secret: run ./install.sh pass (or install libsecret-tools for the keyring backend)" >&2
    exit 1
fi

names() {
    if [[ $BACKEND == pass ]]; then
        find "$STORE" -name '*.gpg' -not -path '*/.git/*' -printf '%P\n' | sed 's/\.gpg$//' | sort
    else
        # secret-tool prints search results on stderr
        secret-tool search --all dots 1 2>&1 | awk -F' = ' '$1 == "attribute.name" { print $2 }' | sort -u
    fi
}

store() {
    local name="$1"
    if [[ $BACKEND == pass ]]; then
        pass insert -m -f "$name" >/dev/null
    else
        secret-tool store --label="dots: $name" dots 1 name "$name"
    fi
}

fetch() {
    if [[ $BACKEND == pass ]]; then
        pass show "$1" | head -n 1
    else
        local value
        value="$(secret-tool lookup dots 1 name "$1")" && printf '%s\n' "$value"
    fi
}

clip() {
    local name="$1" value
    value="$(fetch "$name")" || { echo "not found: $name" >&2; exit 1; }
    printf '%s' "$value" | xclip -selection clipboard
    command -v notify-send >/dev/null && notify-send -t 2000 "Secret" "Copied $name (clears in 45s)" || true
    ( sleep 45; [[ "$(xclip -o -selection clipboard 2>/dev/null)" == "$value" ]] && printf '' | xclip -selection clipboard ) >/dev/null 2>&1 &
}

pass_only() { [[ $BACKEND == pass ]] || { echo "dots-secret $1 needs pass; run ./install.sh pass" >&2; exit 1; }; }

case "${1:-}" in
    backend) echo "$BACKEND" ;;
    set)
        name="${2:?name}"
        if [[ -t 0 ]]; then
            read -rs -p "Value for $name: " value; echo
            printf '%s\n' "$value" | store "$name"
        else
            store "$name"
        fi
        echo "stored $name ($BACKEND)"
        ;;
    get)  fetch "${2:?name}" ;;
    copy) clip "${2:?name}" ;;
    ls)   names ;;
    find) names | grep -i -- "${2:-}" ;;
    rm)
        if [[ $BACKEND == pass ]]; then pass rm -f "${2:?name}" >/dev/null; else secret-tool clear dots 1 name "${2:?name}"; fi
        echo "removed $2"
        ;;
    menu)
        name="$(names | rofi -dmenu -i -p "Secret" -no-custom -theme-str 'window { width: 28em; }')" || exit 0
        [[ -n "$name" ]] && exec "$0" copy "$name"
        ;;
    show) pass_only show; pass show "${2:?name}" ;;
    gen)  pass_only gen; pass generate -f "${2:?name}" "${3:-32}" >/dev/null && echo "generated $2" ;;
    edit) pass_only edit; pass edit "${2:?name}" ;;
    grep) pass_only grep; pass grep -- "${2:?text}" ;;
    sync)
        pass_only sync
        if pass git remote get-url origin >/dev/null 2>&1; then
            pass git pull --rebase --quiet && pass git push --quiet && echo "synced"
        else
            echo "no remote: pass git remote add origin <private repo url>" >&2
            exit 1
        fi
        ;;
    *)
        sed -n '2,19p' "$0"
        exit 2
        ;;
esac
