#!/usr/bin/env bash
# Secrets with pass (GPG-encrypted files in ~/.password-store, git-synced).
#
#   dots-secret set <name>        store (prompts, or reads stdin when piped)
#   dots-secret get <name>        print the secret (first line)
#   dots-secret show <name>       print everything, including notes
#   dots-secret copy <name>       copy to clipboard, cleared after 45s
#   dots-secret gen <name> [len]  generate and store a random secret
#   dots-secret edit <name>       edit in $EDITOR (multi-line: secret, then notes)
#   dots-secret ls                list names
#   dots-secret find <text>       list names matching text
#   dots-secret grep <text>       search inside secrets
#   dots-secret rm <name>         delete
#   dots-secret sync              git pull + push the store
#   dots-secret menu              rofi: pick a name, copy it
#
# In scripts:  export AWS_SECRET_ACCESS_KEY="$(dots-secret get aws/sandbox)"
set -Eeuo pipefail

command -v pass >/dev/null || { echo "dots-secret: pass is not installed; run ./install.sh pass" >&2; exit 1; }
STORE="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
[[ -f "$STORE/.gpg-id" ]] || { echo "dots-secret: store not initialised; run ./install.sh pass" >&2; exit 1; }

names() {
    find "$STORE" -name '*.gpg' -not -path '*/.git/*' -printf '%P\n' | sed 's/\.gpg$//' | sort
}

case "${1:-}" in
    set)
        name="${2:?name}"
        if [[ -t 0 ]]; then
            read -rs -p "Value for $name: " value; echo
            printf '%s\n' "$value" | pass insert -m -f "$name" >/dev/null
        else
            pass insert -m -f "$name" >/dev/null
        fi
        echo "stored $name"
        ;;
    get)  pass show "${2:?name}" | head -n 1 ;;
    show) pass show "${2:?name}" ;;
    copy)
        pass show -c "${2:?name}" >/dev/null
        command -v notify-send >/dev/null && notify-send -t 2000 "Secret" "Copied $2 (clears in 45s)" || true
        ;;
    gen)  pass generate -f "${2:?name}" "${3:-32}" >/dev/null && echo "generated $2" ;;
    edit) pass edit "${2:?name}" ;;
    ls)   names ;;
    find) names | grep -i -- "${2:-}" ;;
    grep) pass grep -- "${2:?text}" ;;
    rm)   pass rm -f "${2:?name}" >/dev/null && echo "removed $2" ;;
    sync)
        if pass git remote get-url origin >/dev/null 2>&1; then
            pass git pull --rebase --quiet && pass git push --quiet && echo "synced"
        else
            echo "no remote: pass git remote add origin <private repo url>" >&2
            exit 1
        fi
        ;;
    menu)
        name="$(names | rofi -dmenu -i -p "Secret" -no-custom -theme-str 'window { width: 28em; }')" || exit 0
        [[ -n "$name" ]] && exec "$0" copy "$name"
        ;;
    *)
        sed -n '2,16p' "$0"
        exit 2
        ;;
esac
