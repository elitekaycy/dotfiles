#!/usr/bin/env bash
# Secrets in the GNOME keyring (unlocked by your login; nothing to set up).
#
#   dots-secret set <name>            store (prompts, or reads stdin when piped)
#   dots-secret get <name>            print
#   dots-secret copy <name>           copy to clipboard, cleared after 30s
#   dots-secret ls                    list names
#   dots-secret find <text>           list names matching text
#   dots-secret rm <name>             delete
#   dots-secret menu                  rofi: pick a name, copy it
#
# Use in scripts:  export AWS_SECRET_ACCESS_KEY="$(dots-secret get aws/sandbox)"
set -Eeuo pipefail

command -v secret-tool >/dev/null || { echo "dots-secret: install libsecret-tools" >&2; exit 1; }

names() {
    secret-tool search --all dots 1 2>/dev/null | awk -F' = ' '$1 == "attribute.name" { print $2 }' | sort -u
}

case "${1:-}" in
    set)
        name="${2:?name}"
        if [[ -t 0 ]]; then
            read -rs -p "Value for $name: " value; echo
        else
            value="$(cat)"
        fi
        printf '%s' "$value" | secret-tool store --label="dots: $name" dots 1 name "$name"
        echo "stored $name"
        ;;
    get)
        secret-tool lookup dots 1 name "${2:?name}"
        ;;
    copy)
        name="${2:?name}"
        value="$(secret-tool lookup dots 1 name "$name")" || { echo "not found: $name" >&2; exit 1; }
        printf '%s' "$value" | xclip -selection clipboard
        command -v notify-send >/dev/null && notify-send -t 2000 "Secret" "Copied $name (clears in 30s)" || true
        ( sleep 30; [[ "$(xclip -o -selection clipboard 2>/dev/null)" == "$value" ]] && printf '' | xclip -selection clipboard ) >/dev/null 2>&1 &
        ;;
    ls)
        names
        ;;
    find)
        names | grep -i -- "${2:-}"
        ;;
    rm)
        secret-tool clear dots 1 name "${2:?name}" && echo "removed $2"
        ;;
    menu)
        name="$(names | rofi -dmenu -i -p "Secret" -no-custom -theme-str 'window { width: 28em; }')" || exit 0
        [[ -n "$name" ]] && exec "$0" copy "$name"
        ;;
    *)
        sed -n '2,12p' "$0"
        exit 2
        ;;
esac
