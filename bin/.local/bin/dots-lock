#!/usr/bin/env bash
# Lock the screen with the active theme's background colour.
set -Eeuo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
theme="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/theme" 2>/dev/null || echo tokyo-night)"

BG="#1a1b26"
theme_file="$CONFIG_HOME/themes/themes/$theme.conf"
[[ -f "$theme_file" ]] && source "$theme_file"

exec i3lock -c "${BG#\#}" "$@"
